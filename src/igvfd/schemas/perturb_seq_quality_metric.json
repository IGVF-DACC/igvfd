{
    "title": "Perturb-seq Quality Metric",
    "$id": "/profiles/perturb_seq_quality_metric.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Schema for submission of a Perturb-seq uniform pipeline quality metric.",
    "type": "object",
    "required": [
        "award",
        "lab",
        "quality_metric_of",
        "analysis_step_version"
    ],
    "identifyingProperties": [
        "uuid",
        "aliases"
    ],
    "additionalProperties": false,
    "mixinProperties": [
        {
            "$ref": "quality_metric.json#/properties"
        },
        {
            "$ref": "mixins.json#/basic_item"
        },
        {
            "$ref": "mixins.json#/attribution"
        },
        {
            "$ref": "mixins.json#/attachment"
        },
        {
            "$ref": "mixins.json#/release_timestamp"
        },
        {
            "$ref": "mixins.json#/standard_status"
        },
        {
            "$ref": "mixins.json#/preview_timestamp"
        }
    ],
    "dependentSchemas": {
        "$merge": [
            "quality_metric.json#/dependentSchemas"
        ]
    },
    "properties": {
        "schema_version": {
            "default": "2"
        },
        "total_cells_passing_filters": {
            "title": "Total Cells Passing Filters",
            "description": "Total Cells Passing Filters",
            "type": "number",
            "submissionExample": {
                "appscript": 8,
                "igvf_utils": 8
            }
        },
        "frac_cells_with_guide": {
            "title": "Fraction Cells With Guide",
            "description": "Fraction of cells with at least one assigned guide.",
            "type": "number",
            "submissionExample": {
                "appscript": 8,
                "igvf_utils": 8
            }
        },
        "avg_cells_per_guide": {
            "title": "Average Cells Per Guide",
            "description": "Average number of cells assigned to each guide.",
            "type": "number",
            "submissionExample": {
                "appscript": 8,
                "igvf_utils": 8
            }
        },
        "moi": {
            "title": "Multiplicity Of Infection",
            "description": "Multiplicity Of Infection",
            "type": "number",
            "submissionExample": {
                "appscript": 8,
                "igvf_utils": 8
            }
        },
        "avg_umis_per_cell": {
            "title": "Average UMIs Per Cell",
            "description": "Average UMIs Per Cell",
            "type": "number",
            "submissionExample": {
                "appscript": 8,
                "igvf_utils": 8
            }
        },
        "total_guides": {
            "title": "Total Guides",
            "description": "Total Guides",
            "type": "number",
            "submissionExample": {
                "appscript": 8,
                "igvf_utils": 8
            }
        },
        "umi_median": {
            "title": "Median UMIs Per Cell",
            "description": "Median total gene UMIs per cell after filtering.",
            "type": "number",
            "submissionExample": {
                "appscript": 8,
                "igvf_utils": 8
            }
        },
        "genes_median": {
            "title": "Median Genes Per Cell",
            "description": "Median number of expressed genes per cell after filtering.",
            "type": "number",
            "submissionExample": {
                "appscript": 8,
                "igvf_utils": 8
            }
        },
        "n_cells_with_guide": {
            "title": "Number Of Cells With Guide",
            "description": "Number of cells with at least one assigned guide.",
            "type": "number",
            "submissionExample": {
                "appscript": 8,
                "igvf_utils": 8
            }
        },
        "n_cells_exactly_1_guide": {
            "title": "Number Of Cells With Exactly One Guide",
            "description": "Number of cells with exactly one assigned guide.",
            "type": "number",
            "submissionExample": {
                "appscript": 8,
                "igvf_utils": 8
            }
        },
        "guide_umi_mean": {
            "title": "Mean Guide UMIs Per Cell",
            "description": "Mean total guide UMIs per cell after filtering.",
            "type": "number",
            "submissionExample": {
                "appscript": 8,
                "igvf_utils": 8
            }
        },
        "mean_percent_mitochondrial": {
            "title": "Mean Percent Mitochondrial",
            "description": "Mean percent mitochondrial UMIs per cell.",
            "type": "number",
            "submissionExample": {
                "appscript": 8,
                "igvf_utils": 8
            }
        },
        "n_targets": {
            "title": "Number Of Target Sequences",
            "description": "Total number of target sequences (e.g., transcripts) in the index.",
            "type": "number",
            "submissionExample": {
                "appscript": 356673,
                "igvf_utils": 356673
            }
        },
        "total_reads": {
            "title": "Total Reads",
            "description": "Total reads (n_processed) reported by Kallisto.",
            "type": "number",
            "submissionExample": {
                "appscript": 8,
                "igvf_utils": 8
            }
        },
        "paired_reads_mapped": {
            "title": "Paired Reads Mapped",
            "description": "Paired reads mapped (n_pseudoaligned) reported by Kallisto.",
            "type": "number",
            "submissionExample": {
                "appscript": 8,
                "igvf_utils": 8
            }
        },
        "alignment_percentage": {
            "title": "Alignment Percentage",
            "description": "Alignment percentage (p_pseudoaligned) reported by Kallisto.",
            "type": "number",
            "submissionExample": {
                "appscript": 8,
                "igvf_utils": 8
            }
        },
        "total_detected_scrna_barcodes": {
            "title": "Total Detected scRNA Barcodes",
            "description": "Unfiltered total detected scRNA barcodes (numBarcodes) reported by Kallisto.",
            "type": "number",
            "submissionExample": {
                "appscript": 8,
                "igvf_utils": 8
            }
        },
        "n_unique": {
            "title": "Number Of Reads Uniquely Pseudoaligned",
            "description": "Number of reads that could be pseudoaligned to a unique target sequence.",
            "type": "number",
            "submissionExample": {
                "appscript": 455501195,
                "igvf_utils": 455501195
            }
        },
        "p_unique": {
            "title": "Percentage Of Reads Uniquely Pseudoaligned",
            "description": "Percentage of reads that could be pseudoaligned to a unique target sequence.",
            "type": "number",
            "submissionExample": {
                "appscript": 46.8,
                "igvf_utils": 46.8
            }
        },
        "percentage_barcodes_on_onlist": {
            "title": "Percentage Of Barcodes On Onlist",
            "description": "Percentage of cell barcodes matching an expected list of barcodes (onlist).",
            "type": "number",
            "submissionExample": {
                "appscript": 8,
                "igvf_utils": 8
            }
        },
        "percentage_reads_on_onlist": {
            "title": "Percentage Of Reads On Onlist",
            "description": "Percentage of reads associated with barcodes on the onlist.",
            "type": "number",
            "submissionExample": {
                "appscript": 8,
                "igvf_utils": 8
            }
        },
        "mean_umis_per_barcode": {
            "title": "Mean UMIs Per Barcode",
            "description": "Mean number of UMIs per cell barcode.",
            "type": "number",
            "submissionExample": {
                "appscript": 8,
                "igvf_utils": 8
            }
        }
    },
    "fuzzy_searchable_fields": [
        "aliases",
        "description",
        "lab.title",
        "submitted_by.title",
        "summary"
    ],
    "exact_searchable_fields": [
        "@type",
        "quality_metric_of"
    ],
    "changelog": "/profiles/changelogs/perturb_seq_quality_metric.md"
}
